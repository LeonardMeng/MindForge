{
  "name": "@mastery/schema",
  "version": "0.0.0",
  "private": true,
  "description": "Mastery OS 的文件协议：zod schema、类型和结构化的校验错误。",
  "type": "module",
  "exports": {
    ".": {
      "@mastery/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
