{
  "name": "@mastery/cli",
  "version": "0.0.0",
  "private": true,
  "description": "mastery 命令：profile init / show、init、validate。",
  "type": "module",
  "bin": {
    "mastery": "./dist/main.js"
  },
  "exports": {
    ".": {
      "@mastery/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/main.ts --format esm --dts --clean",
    "test": "vitest run --config ../../vitest.config.ts --root .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mastery/device": "workspace:*",
    "@mastery/platform": "workspace:*",
    "@mastery/platform-node": "workspace:*",
    "@mastery/profile": "workspace:*",
    "@mastery/profile-store-git": "workspace:*",
    "@mastery/schema": "workspace:*",
    "@mastery/store": "workspace:*"
  }
}
