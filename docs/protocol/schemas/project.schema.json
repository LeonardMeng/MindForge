{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastery OS: projects/<slug>/project.yaml",
  "description": "A learning or research goal inside a workspace.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "pattern": "\\S"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "completed",
        "archived"
      ]
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 64
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "status",
    "concepts"
  ],
  "additionalProperties": false
}
