{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastery OS: <profile>/concept-links.yaml",
  "description": "Relations between concepts in different workspaces.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "relation": {
            "type": "string",
            "enum": [
              "requires"
            ]
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "from",
          "relation",
          "to"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "links"
  ],
  "additionalProperties": false
}
