{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastery OS: <profile>/profile.yaml",
  "description": "The user's profile: display name, language and weekly time budget.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|\\d{3}))?$"
    },
    "weekly_minutes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "language",
    "weekly_minutes"
  ],
  "additionalProperties": false
}
