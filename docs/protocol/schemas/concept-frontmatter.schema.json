{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastery OS: concepts/<slug>.md (frontmatter)",
  "description": "YAML frontmatter of a concept. Unknown fields are kept for Obsidian compatibility.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 64
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "prerequisites",
    "status"
  ],
  "additionalProperties": {}
}
