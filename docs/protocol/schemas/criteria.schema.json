{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastery OS: assessments/<slug>/criteria.yaml",
  "description": "Versioned assessment criteria of a concept.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "concept_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "recall": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "focus": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "focus",
                "threshold"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "understanding": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "focus": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "focus",
                "threshold"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "focus": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "focus",
                "threshold"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "application": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "focus": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "focus",
                "threshold"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "transfer": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "focus": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "focus",
                "threshold"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "recall",
        "understanding",
        "reasoning",
        "application",
        "transfer"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "concept_id",
    "version",
    "dimensions"
  ],
  "additionalProperties": false
}
