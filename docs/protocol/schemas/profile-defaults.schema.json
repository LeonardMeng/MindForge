{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastery OS: <profile>/defaults.yaml",
  "description": "Default plugin and model settings; a workspace can override them. No secrets.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "plugins": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^~?[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {},
        "additionalProperties": {}
      }
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*:\\S+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "plugins",
    "model"
  ],
  "additionalProperties": false
}
