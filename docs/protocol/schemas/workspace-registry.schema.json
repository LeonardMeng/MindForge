{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mastery OS: <profile>/workspaces.yaml",
  "description": "Workspaces registered in the profile, with their Git remotes (no local paths).",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "pattern": "\\S"
          },
          "remote": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "remote"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "workspaces"
  ],
  "additionalProperties": false
}
